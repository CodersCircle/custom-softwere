# Default U-Boot environment for the READ-ONLY SD-card firmware dumper.
# Target: WorldTech WT-RV7186BT (Allwinner F1C200s, cFeon EN25QH64A 8 MiB SPI NOR).
# Runs automatically (no UART needed). Only reads SPI flash; writes files to the SD card only.
bootdelay=-2
bootcmd=run dump_all
dump_all=setenv st start; setenv cmp none; setenv sha none; run dump_probe; run dump_report
dump_probe=if sf probe 0; then setenv st probe_ok; run dump_read1; else setenv st probe_FAIL; fi
dump_read1=if sf read 0x80100000 0 0x800000; then setenv st read1_ok; run dump_read2; else setenv st read1_FAIL; fi
dump_read2=if sf read 0x80900000 0 0x800000; then setenv st read2_ok; run dump_save; else setenv st read2_FAIL; fi
dump_save=if cmp.b 0x80100000 0x80900000 0x800000; then setenv cmp PASS; else setenv cmp FAIL; fi; hash sha256 0x80100000 0x800000 sha; if fatwrite mmc 0:1 0x80100000 flash_full.bin 0x800000; then setenv st written; else setenv st write_FAIL; fi; fatwrite mmc 0:1 0x80900000 flash_read2.bin 0x800000
dump_report=env export -t 0x81200000 st cmp sha; fatwrite mmc 0:1 0x81200000 DONE.txt ${filesize}
